import java.util.Arrays;

public class RadixSort {
    public static void main(String[] args) {
        System.out.println("===Первый тест===");
        long[] arr_1 = {123456789012L, 12L, 900000000000L};
        System.out.println("До: " + Arrays.toString(arr_1));
        sort(arr_1);
        System.out.println("По: " + Arrays.toString(arr_1));

        System.out.println("\n===Второй тест===");
        long[] arr_2 = {111111111111L, 101010101010L};
        System.out.println("До: " + Arrays.toString(arr_2));
        sort(arr_2);
        System.out.println("По: " + Arrays.toString(arr_2));
    }

    public static void sort(long[] arr) {
        if (arr == null || arr.length <= 1) return;

        long max = arr[0];
        for (long val : arr) {
            if (val > max) max = val;
        }

        for (long place = 1; max / place > 0; place *= 10) {
            countingSortByDigit(arr, place);
        }
    }

    private static void countingSortByDigit(long[] arr, long place) {
        int n = arr.length;
        int[] count = new int[10];

        for (long val : arr) {
            int digit = (int) ((val / place) % 10);
            count[digit]++;
        }

        for (int digit = 1; digit < 10; digit++) {
            count[digit] += count[digit - 1];
        }

        long[] result = new long[n];
        for (int i = n - 1; i >= 0; i--) {
            int digit = (int) ((arr[i] / place) % 10);
            result[count[digit] - 1] = arr[i];
            count[digit]--;
        }

        System.arraycopy(result, 0, arr, 0, n);
    }
}
